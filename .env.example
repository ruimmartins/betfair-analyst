# ============================================================
# Betfair Analyst - Environment Variables
# Copy this file to .env and fill in your keys
# ============================================================

# API-Football (v3) — https://www.api-football.com/
# Free plan: 100 requests/day
API_FOOTBALL_KEY=

# The Odds API (v4) — https://the-odds-api.com/
# Free plan: 500 requests/month
ODDS_API_KEY=

# Google Gemini API — https://aistudio.google.com/apikey
# Default model: gemini-2.5-flash (can override below)
GEMINI_API_KEY=

# Optional: Override Gemini model (default: gemini-2.5-flash)
# Options: gemini-2.5-flash, gemini-2.5-pro
# GEMINI_MODEL=gemini-2.5-flash

# Telegram Bot — https://core.telegram.org/bots#botfather
# 1. Talk to @BotFather on Telegram, create a bot, get the token
# 2. Send a message to your bot, then visit:
#    https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
#    to find your chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
